# Explicit environment configuration only; this file is NOT automatically loaded.
# Text / vision: online API or a self-hosted compatible service.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Generic text model override, when using --provider openai-compatible:
YANHE_API_KEY=
YANHE_BASE_URL=
YANHE_MODEL=
# Cloud audio, independent from the text/vision provider:
# YANHE_ASR_PROVIDER=openai-compatible
YANHE_ASR_API_KEY=
YANHE_ASR_BASE_URL=
YANHE_ASR_MODEL=
# Alternative presets: --asr-provider gemini / groq
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional independent vision settings; default uses the selected text service.
YANHE_VISION_API_KEY=
YANHE_VISION_BASE_URL=
YANHE_VISION_MODEL=
# Optional FFmpeg / ffprobe paths. Without ffprobe, ASR uses PyAV metadata probing.
YANHE_FFMPEG=
YANHE_FFPROBE=
# Optional Hugging Face endpoint for ASR model downloads (normal HTTPS only).
# HF_ENDPOINT=

# Web UI service types: cloud (default, key required) / self-hosted (key optional).
# YANHE_ASR_DEPLOYMENT=self-hosted
# YANHE_EVENT_DEPLOYMENT=self-hosted
# CLI only: explicitly allow compatible services with no authentication.
# YANHE_ASR_ALLOW_NO_KEY=1
# YANHE_ALLOW_NO_KEY=1
